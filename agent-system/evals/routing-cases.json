{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "typo-stays-small",
      "request": "Correct one typo in README with no claim or runtime impact.",
      "facts": [
        "single documentation line",
        "no model or release authority change"
      ],
      "expectedPrimitive": "current-session-or-one-profile",
      "forbiddenProfiles": [
        "moe-model-validator",
        "moe-release-gate"
      ],
      "reason": "A durable scientific workflow would add no ownership or evidence boundary."
    },
    {
