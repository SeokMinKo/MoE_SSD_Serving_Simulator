        "accuracy claim needs independent evidence"
      ],
      "expectedWorkflow": "model-change",
      "expectedRoleClasses": [
        "scientific-spec",
        "change-owner",
        "independent-model-validator",
        "independent-browser-reviewer",
        "release-gate"
      ],
      "expectedDependencyClasses": [
        [
          "scientific-spec",
          "change-owner"
        ],
        [
          "change-owner",
          "independent-model-validator"
        ],
        [
          "change-owner",
          "independent-browser-reviewer"
        ],
        [
          "independent-model-validator",
          "release-gate"
        ],
        [
          "independent-browser-reviewer",
          "release-gate"
        ]
      ],
      "requiredHumanOrEvidenceGate": "external calibration acceptance for any stronger predictive claim",
      "forbiddenCompletionClaim": "externally validated absolute predictor"
    },
    {
      "id": "ui-regression-avoids-model-validator",
      "request": "Fix a mobile dialog focus regression without changing model inputs or outputs.",
      "facts": [
        "browser-only behavior",
        "no model equation or trust-boundary change"
      ],
      "expectedWorkflow": "software-fix",
      "expectedRoleClasses": [
        "change-owner",
        "independent-browser-reviewer"
      ],
      "expectedDependencyClasses": [
        [
          "change-owner",
          "independent-browser-reviewer"
