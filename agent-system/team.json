        }
      ]
    },
    "browser-feature": {
      "description": "Define a browser feature contract, implement it test-first, and independently verify real behavior.",
      "nodes": [
        {
          "id": "browser-spec",
          "stage": "spec",
          "parents": [],
          "idempotencyKeyTemplate": "moe-browser-{request_digest}-spec"
        },
        {
          "id": "browser-implement",
          "stage": "implement",
          "parents": [
            "browser-spec"
          ],
          "idempotencyKeyTemplate": "moe-browser-{request_digest}-implement"
        },
        {
          "id": "browser-feature-verify",
          "stage": "browser-verify",
          "parents": [
            "browser-implement"
          ],
          "idempotencyKeyTemplate": "moe-browser-{request_digest}-verify"
        }
      ]
    },
    "release": {
      "description": "Independently revalidate model and browser evidence before a conservative release decision.",
      "nodes": [
        {
          "id": "release-model-validate",
          "stage": "model-validate",
          "parents": [],
          "idempotencyKeyTemplate": "moe-release-{request_digest}-model"
        },
        {
          "id": "release-browser-verify",
          "stage": "browser-verify",
          "parents": [],
          "idempotencyKeyTemplate": "moe-release-{request_digest}-browser"
        },
        {
          "id": "release-decision",
          "stage": "release-gate",
          "parents": [
            "release-model-validate",
            "release-browser-verify"
          ],
          "idempotencyKeyTemplate": "moe-release-{request_digest}-gate"
        }
      ]
    }
