  "stages": {
    "spec": {
      "assignee": "moe-spec",
      "label": "Scientific change contract",
      "evidence": [
        "bounded claim and non-goals",
        "units and invariants",
        "Given/When/Then acceptance criteria",
        "falsifying RED probes"
      ],
      "workspace": "board-default",
      "maxRuntime": "1h",
      "maxRetries": 2,
      "remediationOwner": "moe-spec",
      "terminalStates": {
        "done": "The change contract is implementation-ready and distinguishes internal correctness from external validity.",
        "blocked": "A product claim or authority decision changes the valid contract.",
        "failed": "The proposed contract contradicts the repository trust boundary or lacks a falsifiable acceptance criterion."
      }
    },
    "implement": {
      "assignee": "moe-simulator-builder",
      "label": "Test-first simulator implementation",
      "evidence": [
        "observed RED",
        "minimal GREEN change",
        "targeted and full automated gates",
        "runtime evidence or explicit limitation",
        "changed-file inventory"
      ],
      "workspace": "board-default",
      "maxRuntime": "4h",
      "maxRetries": 2,
      "remediationOwner": "moe-simulator-builder",
      "terminalStates": {
        "done": "Acceptance criteria pass with observed RED and GREEN evidence and no unrelated edits.",
        "blocked": "An external prerequisite or unresolved contract conflict prevents a safe change.",
        "failed": "A required invariant, quality gate, or runtime contract remains contradicted."
      }
    },
    "model-validate": {
      "assignee": "moe-model-validator",
      "label": "Independent model validation",
      "evidence": [
        "independent hand oracle",
        "unit and conservation invariants",
        "adversarial and metamorphic probes",
        "external-calibration limitation",
        "permitted and prohibited uses"
      ],
      "workspace": "board-default",
      "maxRuntime": "3h",
      "maxRetries": 1,
      "remediationOwner": "moe-simulator-builder",
      "terminalStates": {
        "done": "Independent evidence supports the scoped model claim without upgrading the Unvalidated Alpha trust boundary.",
        "blocked": "Required calibration, reference trace, or executable environment is unavailable.",
        "failed": "A reproducible unit, causality, conservation, population, or claim-boundary violation exists."
      }
    },
    "browser-verify": {
      "assignee": "moe-browser-repro-reviewer",
      "label": "Independent browser and reproducibility verification",
      "evidence": [
        "fresh npm gates",
        "real-browser desktop and mobile behavior",
        "Worker and artifact replay evidence",
        "accessibility and console evidence",
        "source and release provenance checks"
      ],
      "workspace": "board-default",
      "maxRuntime": "3h",
      "maxRetries": 1,
      "remediationOwner": "moe-simulator-builder",
      "terminalStates": {
        "done": "Fresh automated and real-browser evidence passes with zero release-blocking regression.",
        "blocked": "The browser, runtime, immutable target, or required artifact cannot be verified.",
        "failed": "A reproducible software, browser, accessibility, replay, or provenance regression exists."
      }
    },
    "release-gate": {
      "assignee": "moe-release-gate",
      "label": "Release and provenance gate",
      "evidence": [
        "immutable source revision",
        "full post-change gates",
        "model and browser independent PASS",
        "clean release bundle and rollback",
        "successful remote CI when release is requested"
      ],
      "workspace": "board-default",
      "maxRuntime": "2h",
      "maxRetries": 1,
      "remediationOwner": "moe-simulator-builder",
      "terminalStates": {
        "done": "All release evidence exists and any production action remains within explicit human approval.",
        "blocked": "Approval, credentials, remote CI, signing, publication, or external calibration evidence is missing.",
        "failed": "Provenance, build, installation, rollback, or mandatory release evidence is reproducibly invalid."
      }
    }
  },
  "workflows": {
